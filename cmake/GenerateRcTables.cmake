# GenerateRcTables.cmake - the prompts of the STRINGTABLEs of src/Rmt.rc
# ("status text\ntooltip" per command ID) as a C++ table for the builds
# without a resource compiler, for the script command "dump actions"
# (ActionTable.cpp): generates a C++ file with RmtFindPrompt(), declared in
# ActionTable.h. Run at configure time; changing Rmt.rc re-runs CMake.
#
#   rmt_generate_prompts(<output.cpp> <Rmt.rc> <resource.h>)
#
# Only the command IDs (ID_...) that are defined (resource.h, or the MFC ones of CompatTypes.h) are taken.

function(rmt_generate_prompts output rc header)
    file(READ ${rc} rc_text)
    # a ';' would split the list of matches below
    string(REPLACE ";" "<SEMICOLON>" rc_text "${rc_text}")
    string(REGEX MATCHALL "[ \t]+ID_[A-Za-z0-9_]+[ \t]+\"[^\"\r\n]*\"" entries "${rc_text}")
    set(table "")
    foreach(entry IN LISTS entries)
        string(REGEX REPLACE "^[ \t]+(ID_[A-Za-z0-9_]+)[ \t]+(\".*\")$" "\\1;\\2" parts "${entry}")
        list(GET parts 0 id)
        list(GET parts 1 text)
        string(REPLACE "<SEMICOLON>" ";" text "${text}")
        string(APPEND table "#ifdef ${id}\n    { ${id}, ${text} },\n#endif\n")
    endforeach()
    set(content "// generated by cmake/GenerateRcTables.cmake - do not edit\n#include \"PlatformTypes.h\"\n#include \"ActionTable.h\"\n#include \"resource.h\"\n\n")
    string(APPEND content "static const struct { UINT id; const char* prompt; } prompt_table[] = {\n${table}    { 0, nullptr }\n};\n\n")
    string(APPEND content "const char* RmtFindPrompt(UINT id)\n{\n    for (const auto& p : prompt_table)\n        if (p.id == id) return p.prompt;\n    return nullptr;\n}\n")
    if(EXISTS ${output})
        file(READ ${output} old)
    endif()
    if(NOT "${old}" STREQUAL "${content}")
        file(WRITE ${output} "${content}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${rc} ${header})
endfunction()

# The main menu and the accelerator table of src/Rmt.rc as C++ tables (RmtMenus.h): the Qt frontend builds its
# menu bar and its shortcuts from them, so that Rmt.rc stays the one place the menus and the keys are defined.
#
#   rmt_generate_menus(<output.cpp> <Rmt.rc>)
#
# The menu is the IDR_MAINFRAME MENU, the keys the IDR_MAINFRAME ACCELERATORS (VIRTKEY entries).

function(rmt_generate_menus output rc)
    file(READ ${rc} rc_text)
    string(REPLACE ";" "<SEMICOLON>" rc_text "${rc_text}")
    string(REPLACE "\r" "" rc_text "${rc_text}")
    string(REGEX MATCHALL "[^\n]+" rc_lines "${rc_text}")

    set(menu "")
    set(accelerators "")
    set(section "")
    set(depth 0)
    foreach(raw IN LISTS rc_lines)
        string(STRIP "${raw}" line)
        if(NOT section)
            if(line STREQUAL "IDR_MAINFRAME MENU")
                set(section menu)
                set(depth 0)
            elseif(line STREQUAL "IDR_MAINFRAME ACCELERATORS")
                set(section accelerators)
                set(depth 0)
            endif()
            continue()
        endif()
        if(line STREQUAL "BEGIN")
            math(EXPR depth "${depth} + 1")
            continue()
        endif()
        if(line STREQUAL "END")
            math(EXPR depth "${depth} - 1")
            if(depth EQUAL 0)
                set(section "")
            endif()
            continue()
        endif()
        if(section STREQUAL "menu")
            math(EXPR level "${depth} - 1")
            if(line MATCHES "^POPUP \"([^\"]*)\"")
                string(APPEND menu "    { ${level}, RmtMenuKind::Popup, \"${CMAKE_MATCH_1}\", 0 },\n")
            elseif(line MATCHES "^MENUITEM SEPARATOR")
                string(APPEND menu "    { ${level}, RmtMenuKind::Separator, nullptr, 0 },\n")
            elseif(line MATCHES "^MENUITEM \"([^\"]*)\"[ \t]*,[ \t]*(ID_[A-Za-z0-9_]+)")
                string(APPEND menu "    { ${level}, RmtMenuKind::Item, \"${CMAKE_MATCH_1}\", ${CMAKE_MATCH_2} },\n")
            endif()
        else()
            # "1", ID_X, VIRTKEY, CONTROL, NOINVERT   or   VK_F9, ID_X, VIRTKEY, SHIFT, CONTROL, NOINVERT
            if(line MATCHES "^(\"[^\"]\"|VK_[A-Z0-9_]+)[ \t]*,[ \t]*(ID_[A-Za-z0-9_]+)(.*)$")
                set(key "${CMAKE_MATCH_1}")
                set(id "${CMAKE_MATCH_2}")
                set(flags "${CMAKE_MATCH_3}")
                if(key MATCHES "^\"(.)\"$")
                    set(key "'${CMAKE_MATCH_1}'")
                endif()
                set(modifiers "0")
                if(flags MATCHES "CONTROL")
                    string(APPEND modifiers "|RMT_ACC_CONTROL")
                endif()
                if(flags MATCHES "SHIFT")
                    string(APPEND modifiers "|RMT_ACC_SHIFT")
                endif()
                if(flags MATCHES "ALT")
                    string(APPEND modifiers "|RMT_ACC_ALT")
                endif()
                string(APPEND accelerators "    { ${key}, ${modifiers}, ${id} },\n")
            endif()
        endif()
    endforeach()
    string(REPLACE "<SEMICOLON>" ";" menu "${menu}")

    set(content "// generated by cmake/GenerateRcTables.cmake from Rmt.rc - do not edit\n#include \"PlatformTypes.h\"\n#include \"RmtMenus.h\"\n#include \"resource.h\"\n\n")
    string(APPEND content "const TRmtMenuEntry g_rmtMenu[] = {\n${menu}    { 0, RmtMenuKind::End, nullptr, 0 }\n};\n\n")
    string(APPEND content "const TRmtAccelerator g_rmtAccelerators[] = {\n${accelerators}    { 0, 0, 0 }\n};\n")
    if(EXISTS ${output})
        file(READ ${output} old)
    endif()
    if(NOT "${old}" STREQUAL "${content}")
        file(WRITE ${output} "${content}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${rc})
endfunction()
